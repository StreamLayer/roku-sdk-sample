<component name="MainScene" extends="Scene">
  <interface>
    <field id="exitApp" type="boolean" alwaysnotify="true" value="false" />
  </interface>

  <children>
    <Poster
      id="Background"
      width="1920"
      height="1080"
      uri="pkg:/images/MainScene/background.png" />

    <Poster
      id="Logo"
      width="600"
      height="300"
      uri="pkg:/images/Logo/streamlayer.png"
      translation="[660, 20]" />

      <Group id="eventSection">
      <Label
        id="titleLabel"
        text="Enter Event ID"
        translation="[560, 430]"
        width="800"
        horizAlign="center"
        color="#FFFFFF"
        font="font:LargeSystemFont" />

      <TextEditBox
        id="eventInput"
        translation="[560, 510]"
        width="800"
        height="70"
        hintText="e.g. 8995"
        textColor="#FFFFFF"
        hintTextColor="#7B8A99"
        active="false" />
    </Group>> 

    <Label
      id="vastUrlLabel"
      width="1500"
      height="0"
      translation="[210, 300]"
      text=""
      horizAlign="center"
      vertAlign="center"
      color="#7B8A99"
      wrap="true"
      maxLines="3"
      visible="false" />

    <Button
      id="StartDemoBtn"
      translation="[730, 800]"
      minWidth="460"
      maxWidth="460"
      height="84"
      iconUri=""
      focusedIconUri=""
      focusBitmapUri="pkg:/images/Buttons/start_demo_focused.png"
      focusFootprintBitmapUri="pkg:/images/Buttons/start_demo_default.png"
      showFocusFootprint="true" />

    <StandardKeyboardDialog
      id="KeyboardDialog"
      title="Enter Event ID"
      visible="false" />

    <Label
      id="errorLabel"
      width="1000"
      height="50"
      translation="[460, 800]"
      text=""
      horizAlign="center"
      vertAlign="center"
      color="0xFF5555FF"
      visible="false" />

    <PlayerScreen
      id="PlayerScreen"
      visible="false" />
      
    <Timer
      id="focusTimer"
      repeat="false"
      duration="0.2" />
  </children>

  <script type="text/brightscript" uri="pkg:/components/scenes/MainScene.brs" />
</component>